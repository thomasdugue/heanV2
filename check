#!/usr/bin/env bash
# ./check — LE point d'entrée unique des vérifications. Identique en local, en pre-commit et
# en CI. Leçon V1 : l'agent test-runner devait connaître 4 commandes dans 3 répertoires.
#
#   ./check          toutes les vérifications
#   ./check --fast   seulement les rapides (pre-commit) — pas de Rust, pas de régénération
#
# Une vérification qui manque s'ajoute ICI ; on ne crée pas une deuxième commande.
# Mais depuis le 2026-11-25 (ADR 0017) le harnais est **gelé** : une vérification nouvelle
# n'entre que si le défaut qu'elle attrape peut perdre des données ou du son, ou s'il est
# arrivé deux fois. Le reste attend que l'application joue de la musique.
#
# Reste à brancher :
#   [ ] budgets de performance              phase 5  (HARNAIS.md §8, chiffres de V1 à mesurer)
#   [ ] appel réel sur l'endpoint updater   phase 6  (ENTRETIEN-DU-HARNAIS.md, audit)
#   [ ] « une version plus récente de la chaîne Rust existe » (audit hebdo — ADR 0008)
#
# Gelés le 2026-11-25, pas annulés — à rouvrir quand le son sort des enceintes :
#   [~] mode parité V1 ↔ V2                 le vrai NAS et dix minutes de protocole manuel
#   [~] régression visuelle                 font mieux, à ce stade, que le conteneur et les
#   [~] conteneur Samba + injection panne    captures. Les trois coûtent plus qu'ils ne
#   [~] « une seule liste des zones Rust »   rapportent avant la parité.
#
# Décisions ouvertes nées du harnais : voir l'index des ADR. Le détail du raisonnement sur les
# listes de zones est en mémoire de l'agent de relecture (`les-listes-de-zones-du-harnais`).

set -uo pipefail
cd "$(dirname "${BASH_SOURCE[0]}")"
FAST=0; [ "${1:-}" = "--fast" ] && FAST=1
fail=0
run() { echo "→ $1"; shift; "$@" || fail=1; echo; }

echo "=== check heanV2 ==="; echo

# Le harnais s'installe tout seul : V1 avait un cas particulier « si node_modules est absent ».
# ⚠️ « Absent » ne suffisait pas : un `node_modules` PÉRIMÉ passait au travers. Le 2026-11-25,
# `fast-check` était arrivé dans `package.json` sans être installé localement, et `./check`
# rendait ROUGE sur un test sans rapport avec le travail en cours — un faux rouge coûte la
# confiance qu'on met dans les vrais. La CI ne le voyait pas : elle part d'un disque nu.
if [ -f package.json ] && { [ ! -d node_modules ] || [ package-lock.json -nt node_modules/.package-lock.json ]; }; then
  echo "→ installation des dépendances (absentes)"
  npm ci --silent || npm install --silent || fail=1
  echo
fi

run "liens markdown"      python3 tools/check-links.py
run "taille de CLAUDE.md" bash tools/check-claude-md.sh
run "taille des fichiers" bash tools/check-sizes.sh
run "skills"              bash tools/check-skills.sh
run "invariants"          node tools/check-invariants.mjs
run "zones jamais déléguées" bash tools/check-zones.sh
run "décisions (ADR)"     node tools/check-adr.mjs
run "chaîne d'outils"     bash tools/check-toolchain.sh
run "fixtures audio"      bash tools/check-fixtures-audio.sh
run "comptes annoncés"    node tools/check-comptes.mjs
run "plafonds d'écriture" node tools/check-plafonds.mjs

if [ -f package.json ]; then
  run "lint"          npm run --silent lint
  run "types"         npm run --silent typecheck
  run "tests"         npm run --silent test
fi

if [ "$FAST" -eq 0 ]; then
  # Le build fait partie des vérifications : un `./check` vert sur un projet qui ne compile
  # pas serait exactement le genre de fausse confiance que ce harnais existe pour empêcher.
  [ -f package.json ] && run "build" npm run --silent build
  if [ -f src-tauri/Cargo.toml ]; then
    run "clippy"      cargo clippy --locked --manifest-path src-tauri/Cargo.toml --all-targets -- -D warnings
    run "cargo test"  cargo test --locked --manifest-path src-tauri/Cargo.toml
  fi
  run "artefacts générés" bash tools/check-generated.sh
fi

# Après le build, pour que dist/ soit frais (en --fast, mesure le dernier build connu).
run "poids & deps"        bash tools/check-weight.sh

# Les comportements de UX-ANTI-REGRESSION.md — tableau de bord ET verdict, selon leur état.
#
# Un comportement encore à porter est rouge : c'est l'avancement du projet, pas une
# régression, et ça ne compte pas dans le verdict. Un comportement PORTÉ, lui, doit passer :
# sinon c'est une régression, et elle doit faire rougir ./check. Jusqu'en phase 2 toute la
# suite était hors verdict — sans conséquence tant qu'aucun comportement n'était porté, et
# un angle mort à la minute où six l'ont été (relevé par invariant-guardian). Le détail du
# raisonnement est en tête de tools/check-comportements.mjs. Voir aussi docs/generated/ux.md.
if [ -f package.json ]; then
  run "comportements portés" node tools/check-comportements.mjs
fi

echo "=== $([ $fail -eq 0 ] && echo 'VERT' || echo 'ROUGE') ==="
exit $fail
