#!/usr/bin/env bash
# ./check — LE point d'entrée unique des vérifications. Identique en local, en pre-commit et
# en CI. Leçon V1 : l'agent test-runner devait connaître 4 commandes dans 3 répertoires, avec
# des cas particuliers. Une seule chose à savoir, une seule chose à maintenir, et la CI ne
# peut pas diverger du local.
#
#   ./check          toutes les vérifications
#   ./check --fast   seulement les rapides (pre-commit) — pas de Rust, pas de régénération
#
# Reste à brancher, au fur et à mesure (voir bootstrap/06-setup-v2/HARNAIS.md) :
#   [x] fixtures audio + backend « fake »   phase 1  (HARNAIS.md §1) — fait
#   [x] property tests de normalisation     phase 2  (HARNAIS.md §4) — fait
#   [ ] mode parité V1 ↔ V2                 phase 2  (HARNAIS.md §5)
#   [ ] régression visuelle                 phase 4  (HARNAIS.md §7)
#   [ ] conteneur Samba + injection panne    phase 5  (HARNAIS.md §12)
#   [ ] budgets de performance              phase 5  (HARNAIS.md §8, chiffres de V1 à mesurer)
#   [ ] appel réel sur l'endpoint updater   phase 6  (ENTRETIEN-DU-HARNAIS.md, audit)
#   [ ] « une version plus récente de la chaîne Rust existe »  (audit hebdo — ADR 0008 :
#       la contrepartie de l'épinglage, signalée en une ligne et non par un build rouge)
#   [ ] ajouter src-tauri/tests et src-tauri/examples aux ZONES de check-sizes  (2026-11-23)
#   [ ] le même angle mort sur INV-06 (🔴) — voir ci-dessous                     (2026-11-23)
#   [ ] « un fichier de docs/generated/ s'annonce-t-il généré ? »                (2026-11-23)
#
# Les trois dernières, nées le 2026-11-23 en fermant les trous d'extensions de check-sizes :
#
#   - Les ZONES de `check-sizes.sh` (`src src-tauri/src tests tools check`) sont, elles aussi,
#     une LISTE. Il y manque `src-tauri/tests/` et `src-tauri/examples/`. **La PR #13 a déjà
#     tranché que `src-tauri/tests` entre dans les garde-fous** — elle l'a ajouté aux ZONES de
#     `aucun-chemin-machine` et de `references-de-tests`, mais PAS ici. L'écart est donc un
#     oubli, pas un choix. ⚠️ Et son TITRE annonce « `src-tauri/tests` entre dans les
#     garde-fous » sans la nuance : qui lit l'historique sans ouvrir ce fichier en conclura que
#     la règle de taille les couvre. Son corps, lui, est exact et ne l'affirme pas. Un titre
#     plus large que son périmètre est la même famille de défaut qu'une règle écrite en prose. Et **le préalable est tombé** : son découpage de `bibliotheque.rs`
#     (416 lignes, qui dépassait la limite sans faire rougir quoi que ce soit depuis la phase 2)
#     ramène le plus gros fichier du dossier à `decodage.rs`, **274 lignes**. L'ajouter ne
#     rougit donc plus rien. `src-tauri/examples/` arrivera avec la migration (PR #8).
#     ⚠️ MAIS LE RACCOURCI NE MARCHE PAS : dériver le périmètre de `git ls-files '*.rs'`, comme
#     proposé en relecture, ramène les **36 fichiers Rust de `bootstrap/`** — l'archive figée de
#     V1 (ADR 0004), dont **13 dépassent 400 lignes**, le plus gros à **2 664**. Les « corriger »
#     falsifierait le relevé historique. On troquerait donc une liste contre une autre. La
#     leçon : **on retourne une liste quand elle énumère ce qu'on a oublié, pas quand elle
#     énumère ce qu'on a choisi.** Celle des extensions décrivait un oubli ; celle des zones
#     décrit une décision — où vit le code vivant, par opposition à l'archive. Donc on
#     l'allonge, on ne la retourne pas.
#   - **Le même angle mort sur une règle 🔴** : le volet Rust du détecteur d'INV-06
#     (`tests/architecture/une-seule-source-de-pistes.test.ts`) ne scanne que `src-tauri/src` et
#     `src-tauri/tests`. Du SQL sur la liste d'exclusion écrit dans `src-tauri/examples/`
#     échapperait donc à INV-06. Vérifié le 2026-11-23 : rien de tel aujourd'hui (`migrer.rs`,
#     51 lignes, zéro `excluded_paths`, sur la branche de migration). Relevé par
#     invariant-guardian en relecture de la PR #8.
#     ⚠️ ET NE PAS SE FIER AU FILET QU'ON CROIT AVOIR. L'entrée d'historique de la PR #13 dit
#     que « `backend.test.ts` refuse déjà tout `.rs` hors des dossiers scannés (ADR 0011) »,
#     donc qu'aucun garde-fou ne peut oublier `examples/`. Mesuré en simulant son arrivée avec
#     du `excluded_paths` dedans : `backend.test.ts` rougit bien **une fois** — mais par le
#     mécanisme de la note « muet » de sa dérogation, qui signale que le dossier vient
#     d'apparaître, PAS la faute. Et `une-seule-source-de-pistes.test.ts` reste à **zéro test
#     rouge** : la violation d'INV-06 passe en silence, complètement. Donc le filet existe, il
#     ne dure qu'un instant, et il ne protège pas la règle qu'on croit. Ce signal unique est
#     exactement le moment où « ces deux listes de zones sont à relire » — à ne pas éteindre
#     sans faire le tour.
#   - Rien ne vérifie qu'un fichier de `docs/generated/` **s'annonce réellement généré**, alors
#     que `CLAUDE.md` l'affirme. Une phrase dans un document ne peut pas échouer : c'est
#     précisément ce que ce harnais existe pour remplacer. Trouvé en éprouvant l'option D.
set -uo pipefail
cd "$(dirname "${BASH_SOURCE[0]}")"
FAST=0; [ "${1:-}" = "--fast" ] && FAST=1
fail=0
run() { echo "→ $1"; shift; "$@" || fail=1; echo; }

echo "=== check heanV2 ==="; echo

# Le harnais s'installe tout seul : V1 avait un cas particulier « si node_modules est absent ».
if [ -f package.json ] && [ ! -d node_modules ]; then
  echo "→ installation des dépendances (absentes)"
  npm ci --silent || npm install --silent || fail=1
  echo
fi

run "liens markdown"      python3 tools/check-links.py
run "taille de CLAUDE.md" bash tools/check-claude-md.sh
run "taille des fichiers" bash tools/check-sizes.sh
run "skills"              bash tools/check-skills.sh
run "invariants"          node tools/check-invariants.mjs
run "zones jamais déléguées" bash tools/check-zones.sh
run "décisions (ADR)"     node tools/check-adr.mjs
run "chaîne d'outils"     bash tools/check-toolchain.sh
run "fixtures audio"      bash tools/check-fixtures-audio.sh
run "comptes annoncés"    node tools/check-comptes.mjs

if [ -f package.json ]; then
  run "lint"          npm run --silent lint
  run "types"         npm run --silent typecheck
  run "tests"         npm run --silent test
fi

if [ "$FAST" -eq 0 ]; then
  # Le build fait partie des vérifications : un `./check` vert sur un projet qui ne compile
  # pas serait exactement le genre de fausse confiance que ce harnais existe pour empêcher.
  [ -f package.json ] && run "build" npm run --silent build
  if [ -f src-tauri/Cargo.toml ]; then
    run "clippy"      cargo clippy --locked --manifest-path src-tauri/Cargo.toml --all-targets -- -D warnings
    run "cargo test"  cargo test --locked --manifest-path src-tauri/Cargo.toml
  fi
  run "artefacts générés" bash tools/check-generated.sh
fi

# Après le build, pour que dist/ soit frais (en --fast, mesure le dernier build connu).
run "poids & deps"        bash tools/check-weight.sh

# Les comportements de UX-ANTI-REGRESSION.md — tableau de bord ET verdict, selon leur état.
#
# Un comportement encore à porter est rouge : c'est l'avancement du projet, pas une
# régression, et ça ne compte pas dans le verdict. Un comportement PORTÉ, lui, doit passer :
# sinon c'est une régression, et elle doit faire rougir ./check. Jusqu'en phase 2 toute la
# suite était hors verdict — sans conséquence tant qu'aucun comportement n'était porté, et
# un angle mort à la minute où six l'ont été (relevé par invariant-guardian). Le détail du
# raisonnement est en tête de tools/check-comportements.mjs. Voir aussi docs/generated/ux.md.
if [ -f package.json ]; then
  run "comportements portés" node tools/check-comportements.mjs
fi

echo "=== $([ $fail -eq 0 ] && echo 'VERT' || echo 'ROUGE') ==="
exit $fail
