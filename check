#!/usr/bin/env bash
# ./check — LE point d'entrée unique des vérifications. Identique en local, en pre-commit et en CI.
# Leçon V1 : l'agent test-runner devait connaître 4 commandes dans 3 répertoires, avec des cas
# particuliers. Une seule chose à savoir, une seule chose à maintenir, et la CI ne peut pas
# diverger du local.
#
#   ./check          toutes les vérifications
#   ./check --fast   seulement les rapides (pre-commit)
#
# À compléter au fur et à mesure (voir bootstrap/06-setup-v2/HARNAIS.md) :
#   [ ] tsc --noEmit                      dès que le frontend existe
#   [ ] lint                              dès que le frontend existe
#   [ ] tests frontend                    dès que le frontend existe
#   [ ] cargo clippy -- -D warnings       dès que le Rust existe
#   [ ] cargo test --locked               dès que le Rust existe
#   [ ] tests d'architecture              phase 0  (HARNAIS.md §2)
#   [ ] couverture des invariants         phase 0  (HARNAIS.md §6)
#   [ ] doc générée à jour                phase 0  (HARNAIS.md §9)
#   [ ] budgets de performance            phase 5  (HARNAIS.md §8, chiffres de V1 à mesurer)
#   [ ] régression visuelle               phase 4  (HARNAIS.md §7)
set -uo pipefail
cd "$(dirname "${BASH_SOURCE[0]}")"
FAST=0; [ "${1:-}" = "--fast" ] && FAST=1
fail=0
run() { echo "→ $1"; shift; "$@" || fail=1; echo; }

echo "=== check heanV2 ==="; echo
run "liens markdown"      python3 tools/check-links.py
run "taille de CLAUDE.md" bash tools/check-claude-md.sh
run "taille des fichiers" bash tools/check-sizes.sh
run "skills"              bash tools/check-skills.sh
run "poids & deps"        bash tools/check-weight.sh

if [ "$FAST" -eq 0 ]; then
  if [ -f package.json ]; then
    run "types"  npm run --silent typecheck
    run "tests"  npm test --silent
  fi
  if [ -f src-tauri/Cargo.toml ]; then
    run "cargo test" cargo test --locked --manifest-path src-tauri/Cargo.toml
  fi
fi

echo "=== $([ $fail -eq 0 ] && echo 'VERT' || echo 'ROUGE') ==="
exit $fail
