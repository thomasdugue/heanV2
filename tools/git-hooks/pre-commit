#!/usr/bin/env bash
# Pre-commit : exactement la même commande qu'en local et qu'en CI, en version rapide.
# Pas de lefthook, pas de seconde liste de vérifications à entretenir — c'est tout l'intérêt
# d'avoir un point d'entrée unique.
#
# Activé automatiquement par `./check` depuis le 2026-11-28, quand `core.hooksPath` est vide.
# Il a attendu une semaine une commande à taper une fois par machine : personne ne l'a tapée,
# et les 81 premiers commits de `main` sont passés sans lui. Une consigne dans un document
# ne s'exécute pas (ADR 0005).
#
# Pour le désactiver : `git config --unset core.hooksPath` — `./check` le reposera. Pour le
# garder désactivé, lui donner une autre valeur, que `./check` ne touche pas.
exec ./check --fast
