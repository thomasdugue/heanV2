+
+/* ============================================================
+   WiFi Sync v3 — App Sync tab takeover
+   ============================================================
+   Lives in #albums-grid alongside the existing dap-* classes.
+   Two screens: welcome (server OFF) and tutorial (server ON).
+   Reuses Noir tokens: --color-bg, --color-bg-surface, --color-text,
+   --color-text-muted, --color-border-light, #4ade80 accent.
+   ============================================================ */
+
+/* === SHARED LAYOUT === */
+.dap-wifi-welcome,
+.dap-wifi-tutorial {
+  max-width: 880px;
+  margin: 0 auto;
+  padding: 56px 48px 80px;
+  color: var(--color-text);
+  font-family: var(--font-sans);
+}
+
+/* === WELCOME (server OFF) ============================================ */
+/* 2026 design pass — Noir Design System compliant.
+   - Geist Mono for hero title and tech UI bits, DM Sans for body copy
+   - White primary CTA per noir-btn-primary; green is reserved for status
+   - Animated broadcast rings in the hero (CSS pseudo-elements)
+   - Numbered benefit cards with bottom accent line (slides in on hover)
+   - Staggered fade-in on mount (--stagger var per element)
+   - Respects prefers-reduced-motion */
+
+.dap-wifi-welcome {
+  position: relative;
+  text-align: center;
+  padding: 64px 48px 64px;
+  isolation: isolate;
+  /* Allow the welcome screen to scroll inside its parent grid container —
+     critical when the window is short so the CTA stays reachable. */
+  max-height: 100%;
+  overflow-y: auto;
+  overflow-x: hidden;
+  scrollbar-width: thin;
+}
+.dap-wifi-welcome::-webkit-scrollbar { width: 6px; }
+.dap-wifi-welcome::-webkit-scrollbar-thumb {
+  background: var(--color-border-light);
+  border-radius: 3px;
+}
+
+/* Subtle radial mesh background — sells "ambient" without busy texture */
+.dap-wifi-bg-mesh {
+  position: absolute;
+  inset: -10% -10% auto -10%;
+  height: 60%;
+  background:
+    radial-gradient(ellipse 60% 50% at 50% 0%, rgba(74, 222, 128, 0.06), transparent 60%),
+    radial-gradient(ellipse 40% 30% at 20% 30%, rgba(255, 255, 255, 0.02), transparent 70%),
+    radial-gradient(ellipse 40% 30% at 80% 30%, rgba(255, 255, 255, 0.02), transparent 70%);
+  pointer-events: none;
+  z-index: -1;
+}
+
+/* === Mount stagger (replaces .dap-fade-in) === */
+.dap-wifi-welcome > *:not(.dap-wifi-bg-mesh):not(.dap-wifi-benefits) {
+  opacity: 0;
+  transform: translateY(12px);
+  animation: dapWifiRise 0.55s cubic-bezier(.2, .65, .25, 1) forwards;
+  animation-delay: calc(var(--stagger, 0) * 70ms + 50ms);
+}
+.dap-wifi-welcome .dap-wifi-benefits {
+  display: grid;
+  grid-template-columns: repeat(3, 1fr);
+  gap: 16px;
+  max-width: 700px;
+  margin: 0 auto 48px;
+}
+.dap-wifi-welcome .dap-wifi-benefit {
+  opacity: 0;
+  transform: translateY(12px);
+  animation: dapWifiRise 0.55s cubic-bezier(.2, .65, .25, 1) forwards;
+  animation-delay: calc(var(--stagger, 0) * 70ms + 50ms);
+}
+
+@keyframes dapWifiRise {
+  from { opacity: 0; transform: translateY(12px); }
+  to   { opacity: 1; transform: translateY(0); }
+}
+
+/* === Hero icon — broadcasting WiFi rings ============================== */
+.dap-wifi-hero {
+  display: flex;
+  justify-content: center;
+  margin-bottom: 28px;
+}
+.dap-wifi-hero-icon {
+  position: relative;
+  width: 140px;
+  height: 140px;
+  display: flex;
+  align-items: center;
+  justify-content: center;
+  color: #fff;
+}
+
+/* Concentric outer halo — conic gradient that slowly rotates */
+.dap-wifi-ring-halo {
+  position: absolute;
+  inset: 0;
+  border-radius: 50%;
+  background: conic-gradient(
+    from 0deg,
+    rgba(74, 222, 128, 0) 0deg,
+    rgba(74, 222, 128, 0.18) 90deg,
+    rgba(255, 255, 255, 0.08) 180deg,
+    rgba(74, 222, 128, 0.18) 270deg,
+    rgba(74, 222, 128, 0) 360deg
+  );
+  filter: blur(14px);
+  opacity: 0.7;
+  animation: dapWifiHalo 14s linear infinite;
+  pointer-events: none;
+}
+
+/* Three broadcasting rings — staggered scale + fade out */
+.dap-wifi-ring {
+  position: absolute;
+  inset: 22px;
+  border-radius: 50%;
+  border: 1px solid rgba(255, 255, 255, 0.18);
+  pointer-events: none;
+  opacity: 0;
+  transform: scale(0.6);
+  animation: dapWifiBroadcast 3.2s cubic-bezier(.2, .6, .25, 1) infinite;
+}
+.dap-wifi-ring-1 { animation-delay: 0s;   }
+.dap-wifi-ring-2 { animation-delay: 1.0s; }
+.dap-wifi-ring-3 { animation-delay: 2.0s; }
+
+@keyframes dapWifiBroadcast {
+  0%   { opacity: 0;    transform: scale(0.55); border-color: rgba(74, 222, 128, 0.55); }
+  18%  { opacity: 0.9;                                                                  }
+  100% { opacity: 0;    transform: scale(1.55); border-color: rgba(74, 222, 128, 0);    }
+}
+
+@keyframes dapWifiHalo {
+  to { transform: rotate(360deg); }
+}
+
+/* Static glyph in the center */
+.dap-wifi-hero-glyph {
+  position: relative;
+  z-index: 1;
+  filter: drop-shadow(0 0 10px rgba(255, 255, 255, 0.18));
+}
+
+/* === Eyebrow label — Geist Mono uppercase ============================= */
+.dap-wifi-eyebrow {
+  display: inline-flex;
+  align-items: center;
+  gap: 8px;
+  font-family: 'Geist Mono', 'SF Mono', monospace;
+  font-size: 11px;
+  font-weight: 500;
+  letter-spacing: 2.4px;
+  text-transform: uppercase;
+  color: var(--color-text-faint);
+  padding: 6px 12px;
+  border: 1px solid var(--color-border);
+  border-radius: 100px;
+  background: rgba(255, 255, 255, 0.015);
+  margin-bottom: 22px;
+}
+.dap-wifi-eyebrow-dot {
+  display: inline-block;
+  width: 6px;
+  height: 6px;
+  border-radius: 50%;
+  background: #4ade80;
+  box-shadow: 0 0 10px rgba(74, 222, 128, 0.8);
+  animation: dapWifiEyebrowPulse 2s ease-in-out infinite;
+}
+@keyframes dapWifiEyebrowPulse {
+  0%, 100% { opacity: 1;   transform: scale(1);   }
+  50%      { opacity: 0.5; transform: scale(0.85);}
+}
+.dap-wifi-eyebrow-sep {
+  color: var(--color-border-light);
+  font-weight: 400;
+}
+
+/* === Title — Geist Mono light, large, tight tracking ================== */
+.dap-wifi-title {
+  font-family: 'Geist Mono', 'SF Mono', monospace;
+  font-size: 44px;
+  font-weight: 300;
+  letter-spacing: -1.6px;
+  line-height: 1.08;
+  margin: 0 0 18px;
+  color: var(--color-text);
+}
+.dap-wifi-title-accent {
+  background: linear-gradient(180deg, #ffffff 0%, #888888 140%);
+  -webkit-background-clip: text;
+  background-clip: text;
+  color: transparent;
+}
+
+/* === Subtitle — DM Sans muted ========================================= */
+.dap-wifi-subtitle {
+  font-family: var(--font-sans);
+  font-size: 14.5px;
+  line-height: 1.6;
+  color: var(--color-text-muted);
+  max-width: 520px;
+  margin: 0 auto 48px;
+}
+
+/* === Benefit cards — passive informational cards ====================== */
+/* No hover lift, no border highlight, no accent line — these are facts,
+   not actions. Cursor stays default; nothing tells the user "click me". */
+.dap-wifi-benefit {
+  position: relative;
+  padding: 24px 20px 26px;
+  background: var(--color-bg-lighter);
+  border: 1px solid var(--color-border);
+  border-radius: 14px;
+  text-align: left;
+  overflow: hidden;
+  cursor: default;
+}
+.dap-wifi-benefit::before {
+  /* very subtle gradient seam at the top — purely decorative */
+  content: '';
+  position: absolute;
+  top: 0; left: 14%;  right: 14%;
+  height: 1px;
+  background: linear-gradient(90deg, transparent, rgba(255,255,255,0.10), transparent);
+  opacity: 0.6;
+}
+
+.dap-wifi-benefit-num {
+  font-family: 'Geist Mono', 'SF Mono', monospace;
+  font-size: 10px;
+  font-weight: 500;
+  letter-spacing: 1.4px;
+  color: var(--color-text-faint);
+  margin-bottom: 14px;
+}
+
+.dap-wifi-benefit-icon {
+  display: inline-flex;
+  align-items: center;
+  justify-content: center;
+  width: 42px;
+  height: 42px;
+  border-radius: 11px;
+  background: rgba(255, 255, 255, 0.03);
+  border: 1px solid var(--color-border);
+  color: var(--color-text);
+  margin-bottom: 14px;
+  transition: background 0.25s ease, border-color 0.25s ease;
+}
+
+.dap-wifi-benefit-title {
+  font-family: var(--font-sans);
+  font-size: 15px;
+  font-weight: 600;
+  margin-bottom: 5px;
+  color: var(--color-text);
+  letter-spacing: -0.1px;
+}
+
+.dap-wifi-benefit-desc {
+  font-family: var(--font-sans);
+  font-size: 12.5px;
+  line-height: 1.5;
+  color: var(--color-text-muted);
+}
+
+/* Bottom accent line — slides in from left on hover (Noir DS pattern) */
+.dap-wifi-benefit-line {
+  position: absolute;
+  bottom: 0;
+  left: 20px;
+  width: 0;
+  height: 2px;
+  background: linear-gradient(90deg, #4ade80, rgba(74, 222, 128, 0));
+  transition: width 0.45s cubic-bezier(.2, .65, .25, 1);
+}
+.dap-wifi-benefit:hover .dap-wifi-benefit-line {
+  width: 48px;
+}
+
+/* === CTA — Noir DS primary (white on black) =========================== */
+.dap-wifi-cta-wrap {
+  display: flex;
+  flex-direction: column;
+  align-items: center;
+  gap: 14px;
+  margin-bottom: 40px;
+}
+
+.dap-wifi-cta {
+  position: relative;
+  display: inline-flex;
+  align-items: center;
+  gap: 10px;
+  padding: 15px 30px 15px 26px;
+  font-family: 'Geist Mono', 'SF Mono', monospace;
+  font-size: 12.5px;
+  font-weight: 600;
+  letter-spacing: 0.4px;
+  text-transform: uppercase;
+  color: #0a0a0a;
+  background: #fff;
+  border: none;
+  border-radius: 10px;
+  cursor: pointer;
+  overflow: visible;
+  transition:
+    transform 0.18s cubic-bezier(.2, .65, .25, 1),
+    box-shadow 0.25s ease,
+    background 0.2s ease;
+  box-shadow: 0 8px 24px -10px rgba(255, 255, 255, 0.25);
+}
+.dap-wifi-cta:hover:not(:disabled) {
+  transform: translateY(-2px);
+  background: #f5f5f5;
+  box-shadow:
+    0 14px 36px -12px rgba(255, 255, 255, 0.32),
+    0 0 0 1px rgba(255, 255, 255, 0.1);
+}
+.dap-wifi-cta:hover:not(:disabled) .dap-wifi-cta-arrow {
+  transform: translateX(4px);
+}
+.dap-wifi-cta:hover:not(:disabled) .dap-wifi-cta-glow {
+  opacity: 1;
+  transform: scale(1.18);
+}
+.dap-wifi-cta:active:not(:disabled) {
+  transform: translateY(0) scale(0.98);
+  transition-duration: 0.08s;
+}
+.dap-wifi-cta:disabled {
+  cursor: wait;
+  background: #e5e5e5;
+}
+.dap-wifi-cta-dot {
+  display: inline-block;
+  width: 7px;
+  height: 7px;
+  border-radius: 50%;
+  background: #4ade80;
+  box-shadow: 0 0 10px rgba(74, 222, 128, 0.7);
+  flex-shrink: 0;
+}
+.dap-wifi-cta.is-starting .dap-wifi-cta-dot {
+  animation: dapWifiCtaPulse 1.1s ease-in-out infinite;
+}
+@keyframes dapWifiCtaPulse {
+  0%, 100% { opacity: 1;   transform: scale(1);   }
+  50%      { opacity: 0.35; transform: scale(0.7);}
+}
+.dap-wifi-cta-arrow {
+  transition: transform 0.25s cubic-bezier(.2, .65, .25, 1), opacity 0.2s ease;
+  flex-shrink: 0;
+}
+/* Soft glow ring expanding behind the button on hover */
+.dap-wifi-cta-glow {
+  position: absolute;
+  inset: -2px;
+  border-radius: 12px;
+  background: radial-gradient(ellipse at center, rgba(255,255,255,0.18), transparent 65%);
+  opacity: 0;
+  transform: scale(0.95);
+  transition: opacity 0.3s ease, transform 0.3s cubic-bezier(.2, .65, .25, 1);
+  pointer-events: none;
+  z-index: -1;
+}
+
+.dap-wifi-cta-hint {
+  font-family: 'Geist Mono', 'SF Mono', monospace;
+  font-size: 11px;
+  letter-spacing: 0.4px;
+  color: var(--color-text-faint);
+  margin: 0;
+}
+
+/* === Responsive ======================================================= */
+@media (max-width: 760px) {
+  .dap-wifi-welcome { padding: 40px 24px 64px; }
+  .dap-wifi-title { font-size: 32px; letter-spacing: -1px; }
+  .dap-wifi-benefits { grid-template-columns: 1fr; max-width: 360px; }
+  .dap-wifi-hero-icon { width: 120px; height: 120px; }
+}
+
+/* === Reduced motion =================================================== */
+@media (prefers-reduced-motion: reduce) {
+  .dap-wifi-welcome > *,
+  .dap-wifi-welcome .dap-wifi-benefit {
+    animation: none !important;
+    opacity: 1 !important;
+    transform: none !important;
+  }
+  .dap-wifi-ring,
+  .dap-wifi-ring-halo,
+  .dap-wifi-eyebrow-dot,
+  .dap-wifi-cta.is-starting .dap-wifi-cta-dot {
+    animation: none !important;
+  }
+  .dap-wifi-benefit:hover { transform: none; }
+}
+
+/* === TUTORIAL (server ON, first time) ================================ */
+/* 2026 design pass — same Noir DS treatment as the welcome screen.
+   - Subtle mesh background, staggered mount, Geist Mono numerals
+   - Hero address block with mono URL + integrated copy chip
+   - QR with conic-gradient halo + corner brackets
+   - Steps as 2-col grid (large mono numeral + body)
+   - White primary CTA (Noir DS), green only for status accent + dot
+   - Responsive scrolling so the CTA never gets hidden */
+
+.dap-wifi-tutorial {
+  position: relative;
+  padding: 32px 48px 64px;
+  isolation: isolate;
+  text-align: left;
+  max-height: 100%;
+  overflow-y: auto;
+  overflow-x: hidden;
+  scrollbar-width: thin;
+  font-family: var(--font-sans);
+  color: var(--color-text);
+}
+.dap-wifi-tutorial::-webkit-scrollbar { width: 6px; }
+.dap-wifi-tutorial::-webkit-scrollbar-thumb {
+  background: var(--color-border-light);
+  border-radius: 3px;
+}
+
+/* Stagger mount — same keyframes as welcome */
+.dap-wifi-tutorial > *:not(.dap-wifi-bg-mesh) {
+  opacity: 0;
+  transform: translateY(12px);
+  animation: dapWifiRise 0.55s cubic-bezier(.2, .65, .25, 1) forwards;
+  animation-delay: calc(var(--stagger, 0) * 70ms + 50ms);
+}
+
+/* === Header: status pill + folder tag + gear ========================== */
+.dap-wifi-tut-header {
+  display: flex;
+  align-items: center;
+  gap: 10px;
+  padding: 10px 14px;
+  margin-bottom: 36px;
+  background: rgba(255, 255, 255, 0.02);
+  border: 1px solid var(--color-border);
+  border-radius: 12px;
+  backdrop-filter: blur(8px);
+}
+
+.dap-wifi-status-pill {
+  display: inline-flex;
+  align-items: center;
+  gap: 8px;
+  padding: 6px 12px;
+  font-family: 'Geist Mono', 'SF Mono', monospace;
+  font-size: 11px;
+  font-weight: 500;
+  letter-spacing: 0.6px;
+  text-transform: uppercase;
+  color: #4ade80;
+  background: rgba(74, 222, 128, 0.08);
+  border: 1px solid rgba(74, 222, 128, 0.22);
+  border-radius: 100px;
+}
+.dap-wifi-status-dot {
+  width: 7px;
+  height: 7px;
+  border-radius: 50%;
+  background: #4ade80;
+  box-shadow: 0 0 10px rgba(74, 222, 128, 0.7);
+  animation: dapWifiEyebrowPulse 2s ease-in-out infinite;
+}
+
+.dap-wifi-folder-tag {
+  display: inline-flex;
+  align-items: center;
+  gap: 7px;
+  padding: 6px 11px;
+  font-family: 'Geist Mono', 'SF Mono', monospace;
+  font-size: 11px;
+  letter-spacing: 0.4px;
+  color: var(--color-text-muted);
+  background: rgba(255, 255, 255, 0.02);
+  border: 1px solid var(--color-border);
+  border-radius: 100px;
+}
+.dap-wifi-folder-tag svg { opacity: 0.7; }
+
+.dap-wifi-icon-btn {
+  margin-left: auto;
+  display: inline-flex;
+  align-items: center;
+  justify-content: center;
+  width: 32px;
+  height: 32px;
+  background: transparent;
+  border: 1px solid var(--color-border);
+  border-radius: 8px;
+  color: var(--color-text-muted);
+  cursor: pointer;
+  transition: color 0.18s ease, border-color 0.18s ease, background 0.18s ease, transform 0.18s cubic-bezier(.2, .65, .25, 1);
+}
+.dap-wifi-icon-btn:hover {
+  color: var(--color-text);
+  border-color: var(--color-border-light);
+  background: rgba(255, 255, 255, 0.04);
+  transform: rotate(30deg);
+}
+
+/* === Eyebrow + title (same vocabulary as welcome) ===================== */
+.dap-wifi-tut-eyebrow {
+  display: inline-flex;
+  align-items: center;
+  gap: 8px;
+  font-family: 'Geist Mono', 'SF Mono', monospace;
+  font-size: 11px;
+  font-weight: 500;
+  letter-spacing: 2.4px;
+  text-transform: uppercase;
+  color: var(--color-text-faint);
+  padding: 6px 12px;
+  border: 1px solid var(--color-border);
+  border-radius: 100px;
+  background: rgba(255, 255, 255, 0.015);
+  margin-bottom: 22px;
+}
+
+.dap-wifi-tut-title {
+  font-family: 'Geist Mono', 'SF Mono', monospace;
+  font-size: 38px;
+  font-weight: 300;
+  letter-spacing: -1.4px;
+  line-height: 1.1;
+  margin: 0 0 30px;
+  color: var(--color-text);
+}
+.dap-wifi-tut-title .dap-wifi-title-accent {
+  background: linear-gradient(180deg, #ffffff 0%, #888888 140%);
+  -webkit-background-clip: text;
+  background-clip: text;
+  color: transparent;
+}
+
+/* === Address block — mono URL + integrated copy chip + inline CTA ===== */
+.dap-wifi-tut-address-block {
+  margin-bottom: 44px;
+}
+.dap-wifi-tut-address-row {
+  display: flex;
+  align-items: stretch;
+  gap: 12px;
+  max-width: 760px;
+}
+.dap-wifi-tut-address-row > code,
+.dap-wifi-tut-address-row > .dap-wifi-copy-btn {
+  background: var(--color-bg);
+  border: 1px solid var(--color-border-light);
+  transition: border-color 0.2s ease, box-shadow 0.25s ease;
+}
+.dap-wifi-tut-address-row > code {
+  border-radius: 12px 0 0 12px;
+  border-right: none;
+}
+.dap-wifi-tut-address-row > .dap-wifi-copy-btn {
+  border-radius: 0 12px 12px 0;
+  border-left: 1px solid var(--color-border);
+}
+.dap-wifi-tut-address-row:hover > code,
+.dap-wifi-tut-address-row:hover > .dap-wifi-copy-btn {
+  border-color: rgba(255, 255, 255, 0.18);
+}
+
+.dap-wifi-tut-cta-inline {
+  flex-shrink: 0;
+  align-self: stretch;
+  padding: 0 24px;
+  font-family: 'Geist Mono', 'SF Mono', monospace;
+  font-size: 11px;
+  font-weight: 600;
+  letter-spacing: 0.9px;
+  text-transform: uppercase;
+  white-space: nowrap;
+  border-radius: 12px;
+  display: inline-flex;
+  align-items: center;
+  gap: 10px;
+}
+.dap-wifi-tut-address-row:hover {
+  border-color: rgba(255, 255, 255, 0.18);
+  box-shadow: 0 0 0 4px rgba(255, 255, 255, 0.02);
+}
+.dap-wifi-tut-address {
+  flex: 1;
+  display: flex;
+  align-items: center;
+  padding: 18px 22px;
+  font-family: 'Geist Mono', 'SF Mono', monospace;
+  font-size: 18px;
+  font-weight: 400;
+  letter-spacing: 0.3px;
+  color: var(--color-text);
+  background: transparent;
+  word-break: break-all;
+  line-height: 1.3;
+}
+.dap-wifi-copy-btn {
+  display: inline-flex;
+  align-items: center;
+  gap: 7px;
+  padding: 0 20px;
+  font-family: 'Geist Mono', 'SF Mono', monospace;
+  font-size: 11px;
+  font-weight: 500;
+  letter-spacing: 0.6px;
+  text-transform: uppercase;
+  color: var(--color-text-muted);
+  background: rgba(255, 255, 255, 0.02);
+  border: none;
+  border-left: 1px solid var(--color-border-light);
+  cursor: pointer;
+  transition: color 0.18s ease, background 0.18s ease;
+}
+.dap-wifi-copy-btn:hover {
+  color: var(--color-text);
+  background: rgba(255, 255, 255, 0.06);
+}
+.dap-wifi-copy-btn:active { background: rgba(255, 255, 255, 0.1); }
+.dap-wifi-copy-btn svg { opacity: 0.8; }
+
+/* === Two-column grid: QR + steps ===================================== */
+.dap-wifi-tut-grid {
+  display: grid;
+  grid-template-columns: 260px 1fr;
+  gap: 48px;
+  align-items: start;
+  margin-bottom: 48px;
+}
+
+/* === QR with halo + corner brackets ================================== */
+.dap-wifi-tut-qr {
+  display: flex;
+  flex-direction: column;
+  align-items: center;
+}
+.dap-wifi-qr-frame {
+  position: relative;
+  width: 244px;
+  height: 244px;
+  padding: 14px;
+  background: #fff;
+  border-radius: 14px;
+  isolation: isolate;
+}
+.dap-wifi-qr-halo {
+  position: absolute;
+  inset: -14px;
+  border-radius: 22px;
+  background: conic-gradient(
+    from 0deg,
+    rgba(74, 222, 128, 0) 0deg,
+    rgba(74, 222, 128, 0.28) 90deg,
+    rgba(255, 255, 255, 0.10) 180deg,
+    rgba(74, 222, 128, 0.28) 270deg,
+    rgba(74, 222, 128, 0) 360deg
+  );
+  filter: blur(16px);
+  opacity: 0.55;
+  animation: dapWifiHalo 14s linear infinite;
+  z-index: -1;
+}
+.dap-wifi-qr-img,
+.dap-wifi-qr-placeholder {
+  width: 100%;
+  height: 100%;
+  display: block;
+  border-radius: 4px;
+  image-rendering: pixelated;
+}
+.dap-wifi-qr-placeholder {
+  background: #f4f4f4;
+  display: flex;
+  align-items: center;
+  justify-content: center;
+  color: #888;
+  font-family: 'Geist Mono', monospace;
+  font-size: 12px;
+}
+/* Corner brackets — viewfinder vibe */
+.dap-wifi-qr-corner {
+  position: absolute;
+  width: 14px;
+  height: 14px;
+  border: 2px solid rgba(255, 255, 255, 0.7);
+  pointer-events: none;
+}
+.dap-wifi-qr-corner-tl { top: -4px;    left: -4px;    border-right: none; border-bottom: none; border-top-left-radius: 4px; }
+.dap-wifi-qr-corner-tr { top: -4px;    right: -4px;   border-left:  none; border-bottom: none; border-top-right-radius: 4px; }
+.dap-wifi-qr-corner-bl { bottom: -4px; left: -4px;    border-right: none; border-top:    none; border-bottom-left-radius: 4px; }
+.dap-wifi-qr-corner-br { bottom: -4px; right: -4px;   border-left:  none; border-top:    none; border-bottom-right-radius: 4px; }
+
+.dap-wifi-qr-caption {
+  margin-top: 18px;
+  display: inline-flex;
+  align-items: center;
+  gap: 7px;
+  font-family: 'Geist Mono', 'SF Mono', monospace;
+  font-size: 10.5px;
+  letter-spacing: 0.6px;
+  text-transform: uppercase;
+  color: var(--color-text-faint);
+}
+
+/* === Steps — large mono numeral + body ============================== */
+.dap-wifi-tut-steps {
+  list-style: none;
+  margin: 0;
+  padding: 0;
+  display: flex;
+  flex-direction: column;
+  gap: 4px;
+}
+.dap-wifi-tut-step {
+  position: relative;
+  display: grid;
+  grid-template-columns: 40px 1fr;
+  gap: 16px;
+  align-items: start;
+  padding: 16px 4px;
+  border-bottom: 1px solid rgba(255, 255, 255, 0.04);
+}
+.dap-wifi-tut-step:last-child { border-bottom: none; }
+
+.dap-wifi-step-num {
+  font-family: 'Geist Mono', 'SF Mono', monospace;
+  font-size: 26px;
+  font-weight: 300;
+  letter-spacing: -0.5px;
+  color: var(--color-text-faint);
+  line-height: 1;
+  padding-top: 4px;
+}
+.dap-wifi-step-icon {
+  display: inline-flex;
+  align-items: center;
+  justify-content: center;
+  width: 40px;
+  height: 40px;
+  border-radius: 10px;
+  background: rgba(255, 255, 255, 0.03);
+  border: 1px solid var(--color-border);
+  color: var(--color-text);
+  flex-shrink: 0;
+  margin-top: 2px;
+  transition: background 0.2s ease, border-color 0.2s ease, transform 0.2s ease;
+}
+.dap-wifi-tut-step:hover .dap-wifi-step-icon {
+  background: rgba(74, 222, 128, 0.06);
+  border-color: rgba(74, 222, 128, 0.22);
+  transform: translateY(-1px);
+}
+.dap-wifi-step-body {
+  display: flex;
+  flex-direction: column;
+  gap: 5px;
+}
+.dap-wifi-step-title {
+  font-family: var(--font-sans);
+  font-size: 14.5px;
+  font-weight: 600;
+  color: var(--color-text);
+  letter-spacing: -0.1px;
+}
+.dap-wifi-step-text {
+  font-family: var(--font-sans);
+  font-size: 13px;
+  line-height: 1.55;
+  color: var(--color-text-muted);
+}
+.dap-wifi-step-text strong {
+  color: var(--color-text);
+  font-weight: 600;
+}
+.dap-wifi-step-text em {
+  font-style: normal;
+  color: var(--color-text);
+  background: rgba(255, 255, 255, 0.06);
+  padding: 1px 6px;
+  border-radius: 4px;
+  font-family: 'Geist Mono', 'SF Mono', monospace;
+  font-size: 12px;
+}
+
+/* === Footer: dismiss + white CTA ==================================== */
+.dap-wifi-tut-footer {
+  display: flex;
+  align-items: center;
+  justify-content: space-between;
+  gap: 24px;
+  padding-top: 28px;
+  border-top: 1px solid var(--color-border);
+}
+
+.dap-wifi-dismiss {
+  display: inline-flex;
+  align-items: center;
+  gap: 10px;
+  font-family: var(--font-sans);
+  font-size: 12.5px;
+  color: var(--color-text-muted);
+  cursor: pointer;
+  user-select: none;
+}
+.dap-wifi-dismiss input[type="checkbox"] {
+  position: absolute;
+  opacity: 0;
+  pointer-events: none;
+}
+.dap-wifi-dismiss-box {
+  display: inline-flex;
+  align-items: center;
+  justify-content: center;
+  width: 16px;
+  height: 16px;
+  border: 1px solid var(--color-border-light);
+  border-radius: 4px;
+  background: var(--color-bg);
+  color: transparent;
+  transition: background 0.18s ease, border-color 0.18s ease, color 0.18s ease;
+}
+.dap-wifi-dismiss:hover .dap-wifi-dismiss-box { border-color: var(--color-text-faint); }
+.dap-wifi-dismiss input:checked + .dap-wifi-dismiss-box {
+  background: #fff;
+  border-color: #fff;
+  color: #0a0a0a;
+}
+
+/* Tutorial CTA reuses .dap-wifi-cta from welcome (white, glow ring, arrow) */
+.dap-wifi-tut-cta {
+  padding: 14px 26px 14px 28px;
+}
+
+/* === Responsive ===================================================== */
+@media (max-width: 820px) {
+  .dap-wifi-tutorial { padding: 24px 28px 56px; }
+  .dap-wifi-tut-title { font-size: 30px; letter-spacing: -1px; }
+  .dap-wifi-tut-grid {
+    grid-template-columns: 1fr;
+    gap: 36px;
+  }
+  .dap-wifi-tut-qr { align-self: center; }
+  .dap-wifi-tut-address { font-size: 15px; padding: 16px 18px; }
+  .dap-wifi-tut-footer {
+    flex-direction: column;
+    align-items: stretch;
+    gap: 18px;
+  }
+  .dap-wifi-tut-cta { justify-content: center; }
+}
+
+/* === Reduced motion ================================================= */
+@media (prefers-reduced-motion: reduce) {
+  .dap-wifi-tutorial > * {
+    animation: none !important;
+    opacity: 1 !important;
+    transform: none !important;
+  }
+  .dap-wifi-status-dot,
+  .dap-wifi-qr-halo,
+  .dap-wifi-icon-btn:hover {
+    animation: none !important;
+    transform: none !important;
+  }
+}
+
+/* === SETTINGS POPOVER === */
+.dap-wifi-popover {
+  width: 280px;
+  padding: 14px;
+  background: var(--color-bg-surface);
+  border: 1px solid var(--color-border-light);
+  border-radius: 10px;
+  box-shadow: 0 12px 32px rgba(0, 0, 0, 0.5);
+  z-index: 10000;
+  font-family: var(--font-sans);
+}
+.dap-wifi-pop-section {
+  margin-bottom: 12px;
+}
+.dap-wifi-pop-label {
+  display: block;
+  font-size: 11.5px;
+  text-transform: uppercase;
+  letter-spacing: 0.6px;
+  color: var(--color-text-faint);
+  margin-bottom: 8px;
+}
+.dap-wifi-pop-section input[type="text"] {
+  width: 100%;
+  padding: 8px 12px;
+  font-size: 13px;
+  font-family: inherit;
+  color: var(--color-text);
+  background: var(--color-bg);
+  border: 1px solid var(--color-border-light);
+  border-radius: 6px;
+  box-sizing: border-box;
+}
+.dap-wifi-pop-section input[type="text"]:focus {
+  outline: none;
+  border-color: #4ade80;
+}
+.dap-wifi-pop-hint {
+  margin-top: 6px;
+  font-size: 11px;
+  color: var(--color-text-faint);
+}
+.dap-wifi-pop-hint .mono {
+  font-family: 'Geist Mono', monospace;
+}
+.dap-wifi-pop-divider {
+  height: 1px;
+  background: var(--color-border);
+  margin: 12px 0;
+}
+.dap-wifi-pop-btn {
+  display: flex;
+  align-items: center;
+  gap: 10px;
+  width: 100%;
+  padding: 10px 12px;
+  font-size: 13px;
+  font-family: inherit;
+  color: var(--color-text);
+  background: transparent;
+  border: 1px solid var(--color-border);
+  border-radius: 6px;
+  cursor: pointer;
+  text-align: left;
+  margin-bottom: 8px;
+  transition: all 0.15s ease;
+}
+.dap-wifi-pop-btn:hover {
+  background: var(--color-bg-hover);
+  border-color: var(--color-border-light);
+}
+.dap-wifi-pop-btn.danger {
+  color: #f87171;
+}
+.dap-wifi-pop-btn.danger:hover {
+  background: rgba(248, 113, 113, 0.08);
+  border-color: rgba(248, 113, 113, 0.3);
+}
+.dap-wifi-pop-tip {
+  margin-left: auto;
+  display: inline-flex;
+  align-items: center;
+  justify-content: center;
+  width: 16px;
+  height: 16px;
+  font-size: 10px;
+  font-weight: 600;
+  color: var(--color-text-faint);
+  background: var(--color-bg);
+  border: 1px solid var(--color-border-light);
+  border-radius: 50%;
+  cursor: help;
+}
