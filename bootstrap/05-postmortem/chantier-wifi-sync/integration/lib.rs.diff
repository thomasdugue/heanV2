 #[tauri::command]
 fn quit_app(app_handle: tauri::AppHandle) {
+    // Stop WiFi sync server if running
+    if let Ok(mut state) = WIFI_SYNC_STATE.lock() {
+        if let Some(ws) = state.take() {
+            let _ = ws.shutdown_tx.send(());
