-#[tauri::command]
-async fn dap_execute_mtp_sync(
-    app_handle: tauri::AppHandle,
-    files: Vec<(String, String)>,          // (source_path, dest_relative_path) — files to copy
-    files_to_delete: Vec<String>,          // dest_relative_paths to delete from device
