-            },
-            cancel_del,
-        ).await {
-            Ok((deleted, errors)) => {
-                total_files_deleted = deleted;
-                eprintln!("[MTP-SYNC] Delete phase: {}/{} deleted, {} errors",
-                    deleted, total_delete, errors.len());
