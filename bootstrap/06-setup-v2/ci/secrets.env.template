# Secrets compile-time — TEMPLATE (aucune valeur réelle ici)
#
# En V1 : noir-tauri/scripts/.env.local, gitignored, chmod 600.
# Les valeurs réelles sont sur la machine de Thomas — ce fichier ne sert qu'à documenter
# les noms exacts et les pièges.
#
# ⚠️ V1 lisait ces variables avec `option_env!()`, qui renvoie `None` EN SILENCE si la
#    variable manque : le binaire release partait alors sans Sentry, sans feedback ou sans
#    signature, sans aucune erreur. En V2 : `build.rs` + `compile_error!()` en profil release.

# --- Observabilité ---
HEAN_SENTRY_DSN=                 # projet Sentry, région EU (https://de.sentry.io). Ne pas quoter avec des espaces.

# --- Feedback (via worker Cloudflare, pas de token GitHub dans le binaire) ---
NOIR_WORKER_URL=                 # https://<worker>.workers.dev
NOIR_WORKER_SECRET=              # secret partagé app ↔ worker (en-tête X-Noir-Secret)
#
# Piège V1 : les variables s'appellent NOIR_WORKER_* et non FEEDBACK_*.
# Piège V1 : NOIR_GITHUB_FEEDBACK_TOKEN n'existe plus (ancienne archi, avant le worker).
#            Le skill hean-release en parle encore dans sa section « Étapes 0 à 5 » : périmé.
# À trancher en V2 : renommer en HEAN_WORKER_* (cf. 01-produit/NON-GOALS.md, section « Nom du produit »).

# --- Signature Apple (Developer ID, hors Mac App Store) ---
APPLE_SIGNING_IDENTITY=          # "Developer ID Application: <Nom> (XXXXXXXXXX)"
APPLE_TEAM_ID=
APPLE_ID=                        # identifiant Apple Developer
APPLE_PASSWORD=                  # app-specific password Apple (xxxx-xxxx-xxxx-xxxx), PAS le mot de passe iCloud

# --- Clé de signature de l'updater Tauri (minisign) ---
TAURI_SIGNING_PRIVATE_KEY=       # contenu du fichier ~/.tauri/hean.key (multiline, vérifier qu'il n'est pas tronqué)
TAURI_SIGNING_PRIVATE_KEY_PASSWORD=   # optionnel (vide accepté)
#
# Piège V1 : la pubkey dans tauri.conf.json doit matcher cette clé privée. Si on régénère la clé,
#            il faut REBUILDER l'app, sinon les apps déjà installées rejettent les futures mises à jour.

# --- Secrets côté Cloudflare (wrangler secret put, jamais dans ce fichier) ---
# GITHUB_TOKEN        → Issues:RW sur le dépôt de feedback
# NOIR_SECRET         → doit égaler NOIR_WORKER_SECRET ci-dessus
# SENTRY_AUTH_TOKEN   → pour le proxy /sentry/* du dashboard

# --- Secrets côté dépôt GitHub (Settings → Secrets) ---
# NOIR_GITHUB_TOKEN   → utilisé par les workflows (feedback-agent, sprint-plan, sprint-synthesis)
#                       Issues:Read sur le dépôt de feedback
