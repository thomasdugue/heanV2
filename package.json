    "gen": "bash tools/gen/all.sh",
    "tauri": "tauri"
  },
  "dependencies": {
    "@tauri-apps/api": "2.12.5"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@tauri-apps/cli": "2.12.6",
    "@types/node": "^26.6.6",
    "oxlint": "latest",
    "svelte": "5.59.1",
    "svelte-check": "4.7.8",
    "typescript": "5.9.3",
    "vite": "8.3.8",
    "vitest": "5.1.1"
  }
}
