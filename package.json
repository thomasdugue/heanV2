{
  "name": "hean",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Hean — lecteur de musique audiophile macOS (V2)",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit && svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
    "lint": "oxlint --deny-warnings src tests tools",
